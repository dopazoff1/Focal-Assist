FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build:prod

FROM nginx:1.27-alpine AS runtime
ENV BACKEND_UPSTREAM=http://host.docker.internal:8080
COPY docker/nginx/templates/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist/creditplus-focal/browser /usr/share/nginx/html
RUN if [ -f /usr/share/nginx/html/index.csr.html ]; then cp /usr/share/nginx/html/index.csr.html /usr/share/nginx/html/index.html; fi

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
