{
  "name": "creditplus-focal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration production --proxy-config proxy.conf.json",
    "start:dev": "ng serve --configuration development --proxy-config proxy.conf.json",
    "start:public": "node scripts/start-public.cjs",
    "start:akinator": "node scripts/akinator-gateway.cjs",
    "build:prod": "ng build --configuration production",
    "start:prod": "ng serve --configuration production --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:creditplus-focal": "node dist/creditplus-focal/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.2",
    "@lucide/angular": "^1.41.0",
    "@tinymce/tinymce-angular": "^9.1.1",
    "aki-api": "^7.0.1",
    "express": "^5.1.0",
    "mermaid": "^11.12.0",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tinymce": "^8.3.2",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/three": "^0.185.4",
    "jsdom": "^27.1.0",
    "playwright": "^1.58.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
