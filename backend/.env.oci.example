SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://<mysql-private-ip>:3306/focal_db?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

APP_PUBLIC_BASE_URL=https://<your-domain-or-vm-ip>
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://<your-domain-or-vm-ip>
APP_FRAME_ANCESTORS='self' https://<your-domain-or-vm-ip>

SECURITY_JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
SECURITY_JWT_EXPIRATION_SECONDS=43200

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://<your-domain-or-vm-ip>/api/gmail/oauth/callback

CHAT_PUBLIC_BASE_URL=https://<your-domain-or-vm-ip>
CHAT_META_APP_ID=
CHAT_META_REDIRECT_URI=https://<your-domain-or-vm-ip>/api/crm/chats/oauth/callback
CHAT_META_VERIFY_TOKEN=<generate-a-random-webhook-verify-token>

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

TRAINING_ASSETS_DIR=/app/data/training-assets
TRAINING_ASSETS_MAX_BYTES=262144000
